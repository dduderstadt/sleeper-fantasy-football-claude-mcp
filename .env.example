# Copy this file to .env and fill in real values. Never commit .env.

# Your Sleeper league ID (from the league URL, e.g.
# sleeper.com/leagues/<this-number>/team).
SLEEPER_LEAGUE_ID=your_league_id_here

# Your Sleeper user ID (from https://api.sleeper.app/v1/user/<your_username>).
SLEEPER_USER_ID=your_user_id_here

# A long, random secret. Every request to this server must present it as
# an "Authorization: Bearer <token>" header, or it is rejected. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=your_own_long_random_secret_here

# Local dev only — Railway sets PORT itself at runtime, so this is ignored
# in production.
PORT=3000
